{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "thadm beta",
  "identifier": "com.thadm.beta",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000"
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "publisher": "Mediar, Inc.",
    "category": "DeveloperTool",
    "shortDescription": "24/7 memory for your desktop",
    "longDescription": "24/7 memory for your desktop. 100% local. You own your data.",
    "copyright": "",
    "targets": [
      "app",
      "dmg",
      "deb",
      "appimage",
      "nsis"
    ],
    "externalBin": [
      "bun"
    ],
    "icon": [
      "icons/beta/32x32.png",
      "icons/beta/128x128.png",
      "icons/beta/128x128@2x.png",
      "icons/beta/256x256.png",
      "icons/beta/512x512.png",
      "icons/beta/1024x1024.png",
      "icons/beta/icon.icns",
      "icons/beta/icon.ico",
      "icons/thadm-tray-failed.png",
      "icons/thadm-tray-black.png"
    ],
    "resources": [
      "assets/*"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/sbpk516/thadm/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEREMEZFOUFDNjA0QUFGMEYKUldRUHIwcGdyT2tQM1E1NEVNZ081NS9XQzJjQXRZR3dVeE9rSHhFRS9SNWh3L2NyTE1vVEN0MVYK"
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "thadm-beta"
        ]
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "trayIcon": {
      "id": "screenpipe_main",
      "iconPath": "assets/thadm-tray-white.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": true
    },
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$HOME/.thadm/**",
          "**"
        ]
      },
      "csp": null
    },
    "macOSPrivateApi": true
  }
}